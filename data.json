0.653Z", "modified_at": "2026-04-22T14:17:46.136Z", "published_at": "2025-10-02T14:17:24Z", "title": "Advanced Django: A Review", "slug": "advanced-django-a-review", "summary": "this a great course is a must-do for anyone looking to take the next Django step.", "content": "this a content for Django course.", "tags": [1]}}, {"model": "blog.post", "pk": 3, "fields": {"author": 3, "created_at": "2026-04-22T14:54:01.305Z", "modified_at": "2026-04-22T14:54:01.305Z", "published_at": "2026-04-22T14:53:02Z", "title": "Safe Text", "slug": "safe-text", "summary": "safe text in django course!", "content": "hello world this is a safe text test :)!!", "tags": [1]}}, {"model": "blog.post", "pk": 4, "fields": {"author": 1, "created_at": "2026-04-23T12:01:13.388Z", "modified_at": "2026-04-23T12:01:13.388Z", "published_at": "2026-04-23T11:59:40Z", "title": "React Course", "slug": "react-course", "summary": "this is the best React course I studied.", "content": "don't miss this course!", "tags": [3]}}, {"model": "blog.post", "pk": 5, "fields": {"author": 1, "created_at": "2026-04-23T12:03:36.793Z", "modified_at": "2026-04-23T12:03:36.793Z", "published_at": "2026-04-23T12:01:22Z", "title": "Healthy Life style", "slug": "healthy-life-style", "summary": "If you are thinking about changing your habit and have glow up, don't miss this blog :)!", "content": "A healthy lifestyle is a holistic approach to well-being that balances physical, mental, and emotional health through sustainable, daily habits rather than quick fixes. Key pillars include eating whole, nutrient-dense foods, engaging in regular movement, prioritizing quality sleep, and managing stress.", "tags": [3]}}, {"model": "blog.post", "pk": 6, "fields": {"author": 3, "created_at": "2026-04-27T14:18:52.013Z", "modified_at": "2026-04-27T14:18:52.013Z", "published_at": "2026-04-27T14:15:41Z", "title": "Exploring Istanbul in 3 Days", "slug": "exploring-istanbul-in-3-days", "summary": "Istanbul is a city where East meets West, blending history, culture, and modern life.", "content": "Istanbul is a city where East meets West, blending history, culture, and modern life.\r\n\r\nOn your first day, visit Hagia Sophia and the Blue Mosque to experience the city's deep history. On the second day, explore the Grand Bazaar for shopping and local crafts. On the final day, take a ferry along the Bosphorus to see the skyline from the water.\r\n\r\nEvery corner of Istanbul tells a story, making it one of the most unforgettable cities in the world.", "tags": [4]}}, {"model": "blog.post", "pk": 7, "fields": {"author": 3, "created_at": "2026-04-27T14:47:03.141Z", "modified_at": "2026-04-27T14:47:03.142Z", "published_at": "2026-04-27T14:46:14Z", "title": "Why Street Food Tastes Better", "slug": "why-street-food-tastes-better", "summary": "Street food has a unique charm that restaurant meals often lack.", "content": "Street food has a unique charm that restaurant meals often lack.\r\nIt’s fresh, fast, and deeply connected to local culture. Whether it's tacos in Mexico, samosas in India, or burgers in the US, street food reflects the heart of everyday life.\r\nEating from a street vendor often means experiencing authentic flavors that have been passed down for generations.", "tags": [5]}}, {"model": "blango_auth.User", "pk": 1, "fields": {"password": "pbkdf2_sha256$260000$t3jjahJ50uP8JldWOM81Og$smubdyMYo1THaCRGHJJG88C/65dCsrl1WxsHUieKmN8=", "last_login": "2026-04-27T14:14:37.270Z", "is_superuser": true, "username": "admin", "first_name": "", "last_name": "", "email": "codio@example.com", "is_staff": true, "is_active": true, "date_joined": "2026-04-19T13:12:12.562Z", "groups": [], "user_permissions": []}}, {"model": "blango_auth.User", "pk": 2, "fields": {"password": "argon2$argon2id$v=19$m=102400,t=2,p=8$dG5WZHJIaWZBZjc5dVpQUjl3elRmcQ$aW30E6J55LWyTYwE4EJSVg", "last_login": "2026-05-06T15:28:49.044Z", "is_superuser": true, "username": "razan", "first_name": "Razan", "last_name": "Alshaikh", "email": "razanalshaikh@